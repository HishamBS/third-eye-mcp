#!/bin/sh

# Run lint-staged for automated fixes and linting
bun run lint-staged

# Check for SSOT violations (text-brand-ink and other forbidden classes)
echo "Checking for SSOT violations..."
VIOLATIONS=$(grep -r "text-brand-ink" apps/ui/src --include="*.tsx" --include="*.ts" || true)

if [ -n "$VIOLATIONS" ]; then
  echo "❌ SSOT VIOLATION DETECTED: Found forbidden 'text-brand-ink' usage:"
  echo "$VIOLATIONS"
  echo ""
  echo "Please use one of these instead:"
  echo "  - text-brand-foreground (for primary text)"
  echo "  - text-semantic-muted (for secondary text)"
  echo "  - STATUS_TEXT_COLORS from color-mappings.ts"
  exit 1
fi

echo "✅ No SSOT violations found"
