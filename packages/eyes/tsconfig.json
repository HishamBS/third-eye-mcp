{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*.ts",
    "utils/**/*.ts",
    "index.ts",
    "blueprint-client.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.d.ts",
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts.map"
  ],
  "references": [
    { "path": "../constants" },
    { "path": "../types" },
    { "path": "../config" },
    { "path": "../providers" },
    { "path": "../db" }
  ]
}
