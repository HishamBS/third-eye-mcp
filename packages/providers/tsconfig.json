{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["*.ts", "**/*.ts"],
  "exclude": ["dist", "node_modules", "**/__tests__/**/*", "**/*.test.ts"],
  "references": [{ "path": "../types" }, { "path": "../config" }]
}
