    "@third-eye/core": "workspace:*",
    "@third-eye/theme": "workspace:*",
    "@third-eye/types": "workspace:*",
    "@third-eye/utils": "workspace:*",
    "@types/dagre": "^0.7.53",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.3.1",
    "elkjs": "^0.11.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.12",
